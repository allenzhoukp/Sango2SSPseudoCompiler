# Repository keep list
#
# Ignore every working-tree path unless it is explicitly part of the source
# delivery below. This makes `git add -A` safe in a checkout that also contains
# reverse-engineering corpora, generated output, local fixtures, or editor and
# agent state.
*

# Repository metadata and project documentation
!/.gitattributes
!/.gitignore
!/LICENSE
!/Userguide_CN.txt

# Compiler and disassembler sources
!/cc/
!/cc/BranchAnalysis.cpp
!/cc/Config.cpp
!/cc/Config.h
!/cc/FixIdentifierLoader.cpp
!/cc/Lexer.cpp
!/cc/Lexer.h
!/cc/Localization.h
!/cc/Main.cpp
!/cc/Panic.cpp
!/cc/Panic.h
!/cc/Parser.cpp
!/cc/Parser.h
!/cc/ParserObjects.h
!/cc/Sg2dasm2.cpp
!/cc/Sg2dasm2.h
!/cc/Sg2decomp.cpp
!/cc/Token.h
!/cc/TreeAnalysis.cpp
!/cc/TreeConstruction.cpp
!/cc/decompiler/
!/cc/decompiler/*.h
!/cc/decompiler/*.cpp

# Runtime configuration
!/config/
!/config/CONFIG.txt
!/config/INTV_TABLE.txt
!/config/STRUCT_TABLE.txt
!/config/SYSCALL_TABLE.txt

# Build entry point
!/makefile

# Runtime headers, imports, and maintained examples
!/SS-Tutorial.cpp
!/magic.cpp
!/magic_inst.txt
!/magic_structured_odin.cpp
!/magic_structured.cpp
!/magic_utils.cpp
!/magic_with_goto.cpp
!/predefine.inc
!/sg2lang.h
!/system.cpp
!/system_structured.cpp
!/system_structured_odin.cpp

# Intentional executable deliverables
!/sg2asm.exe
!/sg2dasm2.exe
!/sg2decomp.exe
!/ss.exe
