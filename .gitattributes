# Normalize text in Git while keeping Windows-oriented source files CRLF in
# working copies. This does not change legacy Big5/GBK file encodings.
* text=auto

*.cpp text eol=crlf
*.h text eol=crlf
*.inc text eol=crlf
*.txt text eol=crlf
*.json text eol=crlf

*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=crlf
makefile text eol=crlf

# Preserve legacy fixture formatting; whitespace is part of the corpus.
1.cpp -whitespace
STUDY_MAGIC.cpp -whitespace

# Shipped and generated binaries must never undergo text conversion.
*.exe binary
*.so binary
*.dll binary
*.zip binary
